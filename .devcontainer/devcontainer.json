{
  "name": "Zeya Nutrition Monitoring",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Zeya Nutrition",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "npm install && npm run db:demo",
  "postStartCommand": "bash scripts/start-codespace.sh",
  "postAttachCommand": "bash scripts/start-codespace.sh"
}
